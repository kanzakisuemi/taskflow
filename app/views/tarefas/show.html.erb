<h1 class="<%= "atrasada" if @tarefa.atrasada? %>"><%= @tarefa.titulo %></h1>

<p><%= @tarefa.descricao %></p>
<p>
  <strong>Projeto:</strong> <%= link_to @tarefa.projeto, @tarefa.projeto %> ·
  <strong>Responsável:</strong> <%= @tarefa.usuario || "Sem responsável" %>
</p>
<p>
  <strong>Prioridade:</strong> <%= badge @tarefa, :prioridade %> ·
  <strong>Prazo:</strong> <%= data @tarefa.prazo %>
  <% if @tarefa.atrasada? %><span class="badge badge-atrasada">Atrasada</span><% end %>
</p>
<p><strong>Status:</strong> <%= badge @tarefa, :status %></p>
<%= render "status", tarefa: @tarefa %>

<div class="acoes">
  <%= link_to "Editar", edit_tarefa_path(@tarefa), class: "botao" %>
  <%= button_to "Excluir", @tarefa, method: :delete, class: "botao perigo", form: { data: { turbo_confirm: "Excluir esta tarefa?" } } %>
  <%= link_to "Voltar", @tarefa.projeto %>
</div>
